# Firebase Admin SDK service account JSON path
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id

# ML artifact (generated by: python ml/train_model.py)
MODEL_PATH=ml/artifacts/risk_random_forest.pkl
MODEL_VERSION=rf_v1.0

# PyPI client
PYPI_TIMEOUT_SECONDS=30.0
PYPI_MAX_RETRIES=2

# Scan limits
DEPENDENCY_GRAPH_MAX_DEPTH=3
MAX_REQUIREMENTS_PACKAGES=50

# Redis (optional — slowapi storage / Celery broker)
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_SCAN=10/minute

# Dev only: allow "Authorization: Bearer dev:uid:email" tokens
ALLOW_DEV_AUTH_BYPASS=true
DEBUG=true
